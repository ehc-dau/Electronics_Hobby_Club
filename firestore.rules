rules_version = '2';

// EHC: Firestore security rules.
//
// These rules ARE the security model. The web pages only hide buttons; anything not allowed
// here is impossible, whatever someone does in their browser console.
//
// Allowed sign-in domain: the regex in collegeEmail(). If you change CONFIG.allowedDomains in
// public/inventory/index.html, change it here too. Two domains: '^[^@]+@(dau|daiict)[.]ac[.]in$'
//
// Deploy after every change:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function collegeEmail(e) {
      return e.matches('^[^@]+@dau[.]ac[.]in$');
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isCollege() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && collegeEmail(myEmail());
    }
    function isAdmin() {
      return isCollege()
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    /* ---------------- people ---------------- */

    // admins/{email}: document ID is the lower-cased email address.
    // The very first admin is created by hand in the Firebase console (see DEPLOY.md).
    match /admins/{adminEmail} {
      allow get: if isCollege() && (adminEmail == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && adminEmail == adminEmail.lower()
        && collegeEmail(adminEmail);
      allow update: if false;
      // Nobody can remove themselves, so the last admin can never lock everyone out.
      allow delete: if isAdmin() && adminEmail != myEmail();
    }

    // users/{email}: the name and phone each person registers once.
    match /users/{userEmail} {
      allow read: if isCollege() && (userEmail == myEmail() || isAdmin());
      allow create, update: if isCollege()
        && userEmail == myEmail()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      allow delete: if isCollege() && userEmail == myEmail();
    }

    /* ---------------- inventory ---------------- */

    // components/{id}: anyone with a college account can browse; only admins change stock.
    // Nothing private goes here: every field is readable by every member.
    match /components/{componentId} {
      allow read: if isCollege();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.totalQty is number
        && request.resource.data.availableQty is number
        && request.resource.data.availableQty >= 0
        && request.resource.data.availableQty <= request.resource.data.totalQty
        && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 12));
      allow delete: if isAdmin();
    }

    // componentPrivate/{componentId}: core-team remarks and purchase rate for a part.
    // A separate collection because Firestore can't hide single fields from readers.
    match /componentPrivate/{componentId} {
      allow read, write: if isAdmin();
    }

    // locations/{id}: where things are kept, with a small thumbnail. Core team only.
    match /locations/{locationId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'notes', 'thumb', 'photoAt', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && (!('thumb' in request.resource.data) || (request.resource.data.thumb is string && request.resource.data.thumb.size() < 150000));
    }

    // locationPhotos/{locationId}: the full-size photo, fetched only when someone opens it.
    match /locationPhotos/{locationId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    // requests/{id}: you see your own; admins see all.
    match /requests/{requestId} {
      allow read: if isAdmin()
        || (isCollege() && resource.data.requesterEmail == myEmail());

      // Anyone with a college account can open a request, only in their own name, only as
      // "pending". Item quantities and kinds are re-checked against live inventory when the
      // core team approves, so a forged item list can't move stock.
      allow create: if isCollege()
        && request.resource.data.keys().hasOnly(['type', 'requesterEmail', 'requesterName', 'requesterPhone', 'title', 'message', 'neededBy', 'items', 'status', 'createdAt', 'updatedAt', 'history'])
        && request.resource.data.requesterEmail == myEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['component', 'help', 'guidance']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.items is list && request.resource.data.items.size() <= 30;

      // Admins move requests through the lifecycle and can change the items at any point
      // before hand-over. The requester can edit or cancel their own request only while it is
      // "pending": once the core team marks it "reviewing" or approves it, it's locked for them.
      allow update: if isAdmin()
        || (isCollege()
            && resource.data.requesterEmail == myEmail()
            && resource.data.status == 'pending'
            && (
              (request.resource.data.status == 'cancelled'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
              || (request.resource.data.status == 'pending'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'message', 'neededBy', 'items', 'updatedAt'])
                && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
                && request.resource.data.message is string && request.resource.data.message.size() <= 2000
                && request.resource.data.items is list && request.resource.data.items.size() <= 30)
            ));

      allow delete: if isAdmin();
    }

    // requestPrivate/{requestId}: core-team remarks on a request. The requester can read their
    // request document, so anything they mustn't see lives here instead.
    match /requestPrivate/{requestId} {
      allow read, write: if isAdmin();
    }

    /* ---------------- events and check-in ---------------- */

    // events/{id}: public when published (the website lists them, signed in or not).
    // While check-in is open, signed-in college users can read it even if unpublished,
    // so the check-in screen works for internal meetings too.
    match /events/{eventId} {
      allow read: if isAdmin()
        || resource.data.get('published', false) == true
        || (isCollege() && resource.data.get('attendanceOpen', false) == true);
      allow write: if isAdmin();

      // events/{id}/attendance/{email}: one document per person, so nobody can check in twice.
      // A person can check in only themselves, only while check-in is open, only with the code
      // currently on the screen (or the one just before it). Their name must match their
      // registration, their student ID must match their email, and the time is the server's.
      match /attendance/{attendeeEmail} {
        allow read: if isAdmin() || (isCollege() && attendeeEmail == myEmail());
        allow create: if isAdmin()
          || (isCollege()
              && attendeeEmail == myEmail()
              && request.resource.data.keys().hasOnly(['name', 'studentId', 'email', 'at', 'method', 'code'])
              && request.resource.data.email == myEmail()
              && request.resource.data.studentId == myEmail().split('@')[0]
              && request.resource.data.name == get(/databases/$(database)/documents/users/$(myEmail())).data.name
              && request.resource.data.at == request.time
              && request.resource.data.method in ['qr', 'code']
              && get(/databases/$(database)/documents/events/$(eventId)).data.get('attendanceOpen', false) == true
              && request.resource.data.code in [
                   get(/databases/$(database)/documents/eventCodes/$(eventId)).data.current,
                   get(/databases/$(database)/documents/eventCodes/$(eventId)).data.previous
                 ]);
        allow update, delete: if isAdmin();
      }
    }

    // eventCodes/{eventId}: the rotating check-in code. Only the core team's check-in screen
    // reads or writes it; the rules above compare against it without exposing it.
    match /eventCodes/{eventId} {
      allow read, write: if isAdmin();
    }

    /* ---------------- website ---------------- */

    // site/settings is public (whether the site is live, headline, about text, links).
    // site/admin holds the preview key and is core team only.
    match /site/{docId} {
      allow read: if docId == 'settings' || isAdmin();
      allow write: if isAdmin();
    }
    // sitePreview/{key}: a preview link works for whoever knows the key, so these can be
    // fetched one at a time but never listed.
    match /sitePreview/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    // Website content: published items are public; drafts are visible to the core team only.
    // Images inside these docs are small; full-size versions live in photos/.
    match /team/{id} {
      allow read: if resource.data.get('published', false) == true || isAdmin();
      allow write: if isAdmin()
        && (request.resource == null || request.resource.data.get('photo', '').size() < 200000);
    }
    match /projects/{id} {
      allow read: if resource.data.get('published', false) == true || isAdmin();
      allow write: if isAdmin()
        && (request.resource == null || request.resource.data.get('image', '').size() < 300000);
    }
    match /gallery/{id} {
      allow read: if resource.data.get('published', false) == true || isAdmin();
      allow write: if isAdmin()
        && (request.resource == null || request.resource.data.get('image', '').size() < 300000);
    }

    /* ---------------- images ---------------- */

    // photos/{id}: full-size images for event posters, projects and the gallery.
    // Stored as JPEG data URLs because Cloud Storage needs the paid plan.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow delete: if isAdmin();
    }
  }
}
