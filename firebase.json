{
  "hosting": {
    "public": "dist",
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/soon/",
        "type": 302
      },
      {
        "source": "/index.html",
        "destination": "/soon/",
        "type": 302
      },
      {
        "source": "/gallery",
        "destination": "/soon/",
        "type": 302
      },
      {
        "source": "/projects",
        "destination": "/soon/",
        "type": 302
      },
      {
        "source": "/events",
        "destination": "/soon/",
        "type": 302
      },
      {
        "source": "/team",
        "destination": "/soon/",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/soon/index.html"
      }
    ],
    "headers": [
      {
        "source": "/inventory/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/soon/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
